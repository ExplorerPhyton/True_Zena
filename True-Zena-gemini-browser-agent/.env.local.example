


GEMINI_API_KEY=AQ.Ab8RN6KrqlmzIvbgmxWXrwiLiERYpEqMPNMvi63XhlM21Xotww


GEMINI_MODEL=gemini-3.6-flash


GEMINI_AGENT_MODEL=gemini-3.6-flash


AGENT_MAX_STEPS=10
AGENT_MAX_DEEP_SOURCES=2
AGENT_NAVIGATION_TIMEOUT_MS=20000
AGENT_ACTION_TIMEOUT_MS=8000
AGENT_TOTAL_TIMEOUT_MS=90000

AGENT_HEADLESS=true


# --- Video ingestion proxy ----------------------------------------------
# Path to the yt-dlp executable. Install separately (pip install yt-dlp or
# your OS package manager) - it is a Python tool, not an npm package, so
# `npm install` will not install it for you.
YT_DLP_PATH=yt-dlp
# Path to ffmpeg, required by yt-dlp for audio extraction/downsampling.
FFMPEG_PATH=ffmpeg
# Safety limits enforced by server/lib/videoIngest.js before anything is
# downloaded, so a malicious or huge URL can't hang the server.
MAX_VIDEO_DURATION_SECONDS=600
MAX_VIDEO_FILESIZE_MB=60

# --- Local API server (server/index.js) ---------------------------------
PORT=8787

# --- Frontend (safe to expose - no secrets here) -------------------------
# Only needed if the API server is deployed on a different origin than the
# frontend. Leave unset to call same-origin /api/* (works with the Vite
# dev proxy below and with same-domain production hosting).
# VITE_API_BASE_URL=http://127.0.0.1:8787
