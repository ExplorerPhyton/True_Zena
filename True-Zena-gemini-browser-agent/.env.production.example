

# --- Gemini ---------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Gemini browser agent (real web-evidence search for the text checker) -
# Same GEMINI_API_KEY above - no separate key. See .env.local.example for
# what each of these does; defaults shown here are what the code falls
# back to if left unset, so it's fine to delete lines you don't need to
# override.
GEMINI_AGENT_MODEL=gemini-3.6-flash
AGENT_MAX_STEPS=10
AGENT_MAX_DEEP_SOURCES=2
AGENT_NAVIGATION_TIMEOUT_MS=20000
AGENT_ACTION_TIMEOUT_MS=8000
AGENT_TOTAL_TIMEOUT_MS=90000
AGENT_HEADLESS=true
# yt-dlp/ffmpeg must be installed on the production host or container
# image; they are not npm packages and cap:sync will not install them.
YT_DLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
MAX_VIDEO_DURATION_SECONDS=600
MAX_VIDEO_FILESIZE_MB=60

# --- Server ---------------------------------------------------------------
# Most hosts (Render, Railway, Fly.io, etc.) inject PORT for you - only
# set this manually if your platform requires it.
PORT=8787


VITE_API_BASE_URL=https://api.your-domain.example
